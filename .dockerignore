# Build context is trimmed to app/ + requirements.txt. Everything below is
# excluded so it is never copied into the image by `COPY . .`.
# Note: migrations/ are applied programmatically by app/core/postgres.py on
# startup, so the SQL files are not needed inside the image.

# ===== Version control =====
.git
.gitignore

# ===== Python bytecode / caches =====
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# ===== Virtual environments =====
.venv/
venv/
env/
ENV/

# ===== Packaging / build artifacts =====
build/
dist/
*.egg-info/
.eggs/
pyproject.toml

# ===== Tests / coverage =====
tests/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
pytest.ini
test_*.py
*_test.py

# ===== Secrets / environment =====
.env
.env.*
*.pem
*.key

# ===== IDE / editor / tooling =====
.idea/
.vscode/
*.swp
*.swo
.claude/

# ===== OS junk =====
**/.DS_Store
Thumbs.db

# ===== Docs / specs =====
*.md
docs/
specs/

# ===== Logs / temp =====
logs/
*.log
*.tmp
*.temp

# ===== Migrations (applied by postgres.py at startup) =====
migrations/

# ===== Docker / compose =====
Dockerfile*
docker-compose*.yml
docker-compose*.yaml
.dockerignore
